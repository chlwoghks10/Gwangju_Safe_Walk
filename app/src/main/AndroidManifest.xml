<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 이 선언이 없으면 안드로이드 11 이상에서 음성이 나오지 않는다 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="광주 안심길"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GwangjuSafeWalk">

        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="3kxkmc6t4z" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 하단 탭 다섯 개. singleTop 이라야 탭을 오갈 때 쌓이지 않는다 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RouteActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".SavedActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".MayActivity"
            android:exported="false" />

        <!-- 내 위치를 출발지로 쓰는 내비게이션 화면. 화면이 꺼지지 않게 한다 -->
        <activity
            android:name=".NaviActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- 장소명 검색. 열리면 키보드가 바로 올라오게 한다 -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />
    </application>

</manifest>
