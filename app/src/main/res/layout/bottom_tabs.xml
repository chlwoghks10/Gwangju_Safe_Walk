<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tab_bg"
    android:elevation="12dp"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tab_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="7dp"
        android:paddingBottom="9dp">

        <!-- 발견 -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabHomeIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="홈"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/tabHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="홈"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 경로 -->
        <LinearLayout
            android:id="@+id/tabRoute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabRouteIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="경로"
                android:src="@drawable/ic_tab_route" />

            <TextView
                android:id="@+id/tabRouteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="경로"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 지도 -->
        <LinearLayout
            android:id="@+id/tabMap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabMapIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="지도"
                android:src="@drawable/ic_tab_map" />

            <TextView
                android:id="@+id/tabMapText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="지도"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 저장 -->
        <LinearLayout
            android:id="@+id/tabSaved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabSavedIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="저장"
                android:src="@drawable/ic_tab_saved" />

            <TextView
                android:id="@+id/tabSavedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="저장"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 더보기 -->
        <LinearLayout
            android:id="@+id/tabMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabMoreIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="더보기"
                android:src="@drawable/ic_tab_more" />

            <TextView
                android:id="@+id/tabMoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="더보기"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
