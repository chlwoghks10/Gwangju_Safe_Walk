<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- 하단 탭바 -->
    <include
        android:id="@+id/tabBar"
        layout="@layout/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tabBar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:text="더보기"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 시설 데이터 -->
            <TextView
                style="@style/MenuSection"
                android:text="시설 데이터" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowCctv"
                    style="@style/MenuRow">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/fac_cctv" />

                    <TextView
                        style="@style/MenuRowText"
                        android:text="CCTV" />

                    <TextView
                        android:id="@+id/cntCctv"
                        style="@style/MenuRowValue"
                        android:text="—" />
                </LinearLayout>

                <View style="@style/MenuDivider" />

                <LinearLayout
                    android:id="@+id/rowLight"
                    style="@style/MenuRow">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/fac_light" />

                    <TextView
                        style="@style/MenuRowText"
                        android:text="보안등" />

                    <TextView
                        android:id="@+id/cntLight"
                        style="@style/MenuRowValue"
                        android:text="—" />
                </LinearLayout>

                <View style="@style/MenuDivider" />

                <LinearLayout
                    android:id="@+id/rowBell"
                    style="@style/MenuRow">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/fac_bell" />

                    <TextView
                        style="@style/MenuRowText"
                        android:text="안전비상벨" />

                    <TextView
                        android:id="@+id/cntBell"
                        style="@style/MenuRowValue"
                        android:text="—" />
                </LinearLayout>

                <View style="@style/MenuDivider" />

                <LinearLayout
                    android:id="@+id/rowPolice"
                    style="@style/MenuRow">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/fac_police" />

                    <TextView
                        style="@style/MenuRowText"
                        android:text="경찰서 · 지구대" />

                    <TextView
                        android:id="@+id/cntPolice"
                        style="@style/MenuRowValue"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <!-- 설정 -->
            <TextView
                style="@style/MenuSection"
                android:text="설정" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowServer"
                    style="@style/MenuRow">

                    <TextView
                        style="@style/MenuRowText"
                        android:layout_marginStart="0dp"
                        android:text="서버 주소" />

                    <TextView
                        android:id="@+id/valServer"
                        style="@style/MenuRowValue"
                        android:text="—" />
                </LinearLayout>

                <View style="@style/MenuDivider" />

                <LinearLayout
                    android:id="@+id/rowTheme"
                    style="@style/MenuRow">

                    <TextView
                        style="@style/MenuRowText"
                        android:layout_marginStart="0dp"
                        android:text="화면 색" />

                    <TextView
                        android:id="@+id/valTheme"
                        style="@style/MenuRowValue"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <!-- 정보 -->
            <TextView
                style="@style/MenuSection"
                android:text="정보" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowPrinciple"
                    style="@style/MenuRow">

                    <TextView
                        style="@style/MenuRowText"
                        android:layout_marginStart="0dp"
                        android:text="설계 원칙" />

                    <ImageView
                        style="@style/MenuChevron"
                        android:contentDescription="열기" />
                </LinearLayout>

                <View style="@style/MenuDivider" />

                <LinearLayout
                    android:id="@+id/rowSource"
                    style="@style/MenuRow">

                    <TextView
                        style="@style/MenuRowText"
                        android:layout_marginStart="0dp"
                        android:text="데이터 출처" />

                    <ImageView
                        style="@style/MenuChevron"
                        android:contentDescription="열기" />
                </LinearLayout>

                <View style="@style/MenuDivider" />

                <LinearLayout
                    android:id="@+id/rowTeam"
                    style="@style/MenuRow">

                    <TextView
                        style="@style/MenuRowText"
                        android:layout_marginStart="0dp"
                        android:text="만든 사람" />

                    <TextView
                        style="@style/MenuRowValue"
                        android:text="익셉션" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="광주 안심길 · 조선대학교 정보통신공학과"
                android:textColor="@color/text_weak"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
