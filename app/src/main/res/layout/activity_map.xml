<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <fragment
        android:id="@+id/map"
        android:name="com.naver.maps.map.MapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 뒤로 -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle"
        android:elevation="5dp"
        android:padding="11dp"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로"
        android:tint="@color/text_main" />

    <!-- 제목 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pill"
        android:elevation="5dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="안심 지도"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 안내 -->
    <TextView
        android:id="@+id/txtCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_pill"
        android:elevation="5dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 현재 위치 -->
    <ImageView
        android:id="@+id/btnLocate"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_above="@+id/chipScroll"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_circle"
        android:elevation="5dp"
        android:padding="12dp"
        android:src="@drawable/ic_locate"
        android:contentDescription="현재 위치"
        android:tint="@color/brand" />

    <!-- 레이어 칩 -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="22dp"
        android:elevation="5dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/chipLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="보안등"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipCctv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="CCTV"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipBell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="비상벨"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipPolice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="경찰서"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

</RelativeLayout>
