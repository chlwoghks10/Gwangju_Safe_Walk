<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.naver.maps.map.MapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle"
        android:elevation="6dp"
        android:gravity="center"
        android:text="←"
        android:textColor="#1A2340"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pill"
        android:elevation="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="안심 지도"
        android:textColor="#1A2340"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:elevation="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="#6B7590"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnLocate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@+id/chipScroll"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_circle"
        android:elevation="6dp"
        android:gravity="center"
        android:text="◎"
        android:textColor="#2E5CE6"
        android:textSize="22sp" />

    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:elevation="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:orientation="horizontal"
            android:padding="7dp">

            <TextView
                android:id="@+id/chipLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="보안등"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipCctv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="CCTV"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipBell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="비상벨"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipPolice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="경찰서"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

</RelativeLayout>
